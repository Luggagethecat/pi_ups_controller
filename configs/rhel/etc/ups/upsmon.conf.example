# PUBLIC EXAMPLE ONLY. Insert local values privately.
MONITOR ups@192.0.2.10 1 REPLACE_WITH_CLIENT_USERNAME REPLACE_WITH_STRONG_RANDOM_PASSWORD secondary

NOTIFYCMD /sbin/upssched
NOTIFYFLAG ONLINE SYSLOG+EXEC
NOTIFYFLAG ONBATT SYSLOG+EXEC
NOTIFYFLAG LOWBATT SYSLOG+EXEC

# Self-test/bypass changes should not arm outage timers in this design.
NOTIFYFLAG CAL SYSLOG
NOTIFYFLAG NOTCAL SYSLOG
NOTIFYFLAG BYPASS SYSLOG
NOTIFYFLAG NOTBYPASS SYSLOG
