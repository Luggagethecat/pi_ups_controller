[Unit]
Description=UPS power failure email watcher
After=network.target nut-server.service postfix.service
Requires=nut-server.service

[Service]
Type=simple
User=upsdash
Group=upsdash
SupplementaryGroups=postdrop
EnvironmentFile=-/etc/nut-safe-monitoring/site.env
ExecStart=/usr/bin/python3 /usr/local/sbin/ups-power-watch
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ups-dashboard
ReadWritePaths=/var/spool/postfix/maildrop

[Install]
WantedBy=multi-user.target
