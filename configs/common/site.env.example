# Public example only. These are RFC 5737 documentation addresses and will not route.
# Copy to /etc/nut-safe-monitoring/site.env and replace for your environment.

UPS_NAME=ups
UPS_SERVER_IP=192.0.2.10
COMPUTE_IP=192.0.2.20
STORAGE_IP=192.0.2.30

COMPUTE_NAME=compute-node
STORAGE_NAME=storage-node

# Staged outage policy used by the reference design.
VM_SHUTDOWN_SECONDS=180
COMPUTE_SHUTDOWN_SECONDS=240
STORAGE_SHUTDOWN_SECONDS=300
REPORT_SECONDS=390
COMM_LOST_SECONDS=30

# Bind only to trusted management/LAN addresses in a real deployment.
DASHBOARD_LISTEN=127.0.0.1
DASHBOARD_PORT=8080
CONTROLLER_LISTEN=127.0.0.1
CONTROLLER_PORT=8081
